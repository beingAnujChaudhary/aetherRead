# AetherRead API — gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# Virtual environments
venv/
.venv/
env/
.env          # ← real secrets, never commit this

# FastAPI / Uvicorn
*.log

# Data directories — PDFs and ChromaDB are local, never commit
data/uploads/*
data/chroma/*
!data/uploads/.gitkeep
!data/chroma/.gitkeep

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
