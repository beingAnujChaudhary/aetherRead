<Window x:Class="aetherRead_windows_native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:aetherRead_windows_native"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:pdfium="clr-namespace:PdfiumViewer;assembly=PdfiumViewer"
        mc:Ignorable="d"
        Title="AetherRead Native" Height="800" Width="1200" Background="#F0F0F0">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Navigation Rail -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                
                <!-- Logo -->
                <Border Width="40" Height="40" Background="#FF3B30" CornerRadius="8" Margin="0,0,0,30">
                    <TextBlock Text="A" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <Button x:Name="BtnLibrary" Click="BtnLibrary_Click" Margin="0,10" Background="Transparent" BorderThickness="0" Height="60" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Files" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="BtnToolbox" Click="BtnToolbox_Click" Margin="0,10" Background="Transparent" BorderThickness="0" Height="60" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🧰" FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Toolbox" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <!-- Library View -->
            <Grid x:Name="LibraryView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="My AetherRead" FontSize="28" FontWeight="Bold" Margin="30,30,0,10" Grid.Row="0"/>
                
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Welcome to AetherRead Native" FontSize="20" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Open PDF File" Width="150" Height="40" Background="#007AFF" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnOpenPdf_Click"/>
                </StackPanel>
            </Grid>
            
            <!-- Toolbox View -->
            <Grid x:Name="ToolboxView" Visibility="Collapsed" Background="#FFFFFF">
                <TextBlock Text="Toolbox (Coming Soon)" FontSize="28" FontWeight="Bold" Margin="30,30,0,10"/>
            </Grid>
            
            <!-- PDF Reader View -->
            <Grid x:Name="ReaderView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Toolbar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Button Content="Close" Background="Transparent" BorderThickness="0" Margin="0,0,20,0" Cursor="Hand" Click="BtnClosePdf_Click"/>
                            <TextBlock x:Name="TxtFileName" Text="Document.pdf" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="View" Margin="5,0" Padding="10,5" Background="#F0F0F0" BorderThickness="0"/>
                            <Button Content="Annotate" Margin="5,0" Padding="10,5" Background="Transparent" BorderThickness="0"/>
                            <Button Content="Draw" Margin="5,0" Padding="10,5" Background="Transparent" BorderThickness="0"/>
                            <Button Content="Fill &amp; Sign" Margin="5,0" Padding="10,5" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- WindowsFormsHost to hold PdfViewer -->
                <wfi:WindowsFormsHost Grid.Row="1" x:Name="FormsHost">
                    <!-- The actual PdfViewer is added in code-behind -->
                </wfi:WindowsFormsHost>
                
            </Grid>
            
        </Grid>
        
    </Grid>
</Window>
